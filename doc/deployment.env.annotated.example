# MyAI Docker Compose 部署环境变量（逐项注释版）
# 用法：替换全部 replace-with-... 标记后，将本文件复制为部署目录中的 .env。
# 本文件按 Docker Compose 的 .env 语法编写；双引号中的 ${变量名} 会复用前面定义的值。
# 密码、令牌等原始值建议放在单引号中，避免其中的 $ 和 # 被当成插值或注释。
# 可选变量留空时，Agent 通常沿用挂载的 application.yaml；留空不能保证清除 YAML 中的已有值。
# 根 compose.prod.yaml 只启动 Relay 和 Agent；MinIO、OpenSandbox 使用各自部署文件。
# 文件与短链能力依赖另行部署的兼容 short_links MCP 后端，本仓库不再构建旧附件服务。
# 独立 Compose 使用此文件时，需要显式传入 --env-file，并在其 environment/env_file 中配置相应变量。

# ==================== 1. Relay、Agent 身份与工作目录 ====================

# Relay 与 Agent 之间的认证令牌；两端必须一致。请填写重新生成的长随机令牌。
MYAI_RELAY_AGENT_TOKEN='replace-with-new-relay-agent-token'

# Agent 所属用户标识；保留你原来的 Mikasa，Relay 与 Agent 将使用同一个标识。
MYAI_AGENT_USER='Mikasa'

# Agent 设备标识；用于区分同一用户的不同 Agent，保留原来的 server-agent。
MYAI_AGENT_DEVICE='server-agent'

# 允许浏览器 WebSocket 连接的 Origin；当前允许本机开发页面，公网 Web 客户端需加入其实际 Origin。
MYAI_RELAY_ALLOWED_ORIGINS='http://localhost:*,http://127.0.0.1:*'

# Docker 宿主机上的工作目录；根 Compose 将它挂载为 Agent 容器内的 /workspace，需允许 UID 10001 写入。
MYAI_WORKSPACE_PATH='/docker/agent/workspace'

# 已创建的 Docker 外部共享网络名；相关容器必须在各自 Compose 中实际加入该网络才能通过服务名互访。
INFRA_NETWORK='myai-shared'

# Relay 镜像地址；保留你原来的仓库。部署时需确保该标签已发布并包含此次代码修复。
MYAI_RELAY_IMAGE='ghcr.io/yourgaomu/myai-relay:latest'

# Agent 镜像地址；保留你原来的仓库。根生产 Compose 使用镜像，不会自动构建本地源码。
MYAI_AGENT_IMAGE='ghcr.io/yourgaomu/myai-agent:latest'

# ==================== 2. 模型接入 ====================
# 以下采用 OpenAI Chat Completions 兼容接口；如果你的服务采用其他协议，需同步修改接入类型。
# MongoDB 已有模型配置时，启动优先加载数据库模型；修改以下种子配置不会覆盖数据库中的已有模型。

# 模型提供商标识；OpenAI 官方或 OpenAI 兼容接入在此使用 openai。
MYAI_PROVIDER='openai'

# 模型请求协议；这里使用 /chat/completions 接口。
MYAI_PROTOCOL='openai-chat-completions'

# 模型接口认证方式；bearer 表示通过 Authorization: Bearer 发送模型 API Key。
MYAI_AUTH_TYPE='bearer'

# 模型接口真实基础地址，通常以 /v1 结尾。必须替换为你实际使用的服务地址。
MYAI_BASE_URL='https://replace-with-model-api-host.example/v1'

# 上述模型服务签发的真实 API Key；必须替换，程序会拒绝示例密钥。
MYAI_API_KEY='replace-with-real-model-api-key'

# 向模型服务发送的模型名；保留原来的 gpt-5.5，需确认你的服务实际支持这个名称。
MYAI_MODEL='gpt-5.5'

# 模型上下文总容量，单位 token；0 表示未声明容量，采用程序的保守回退值，不能理解为无限。
MYAI_CONTEXT_WINDOW_TOKENS=0

# 模型服务允许的最大输出容量，单位 token；0 表示未声明，不代表请求会要求无限输出。
MYAI_MAX_OUTPUT_LIMIT=0

# ==================== 3. MongoDB 与 Redis ====================

# MongoDB 连接串；替换用户名和密码，凭据中的 URI 保留字符需先做百分号编码。
# 保留你原来的 mongodb 服务名、rs0 副本集和直连参数；MongoDB 必须确实启用了名为 rs0 的副本集。
MONGO_URI='mongodb://replace-with-mongo-user:replace-with-uri-encoded-mongo-password@mongodb:27017/?authSource=admin&replicaSet=rs0&directConnection=true'

# MyAI 主数据库名；保存会话、模型、任务、知识库等业务数据，保留原来的 myai。
MONGO_DATABASE='myai'

# Agent 访问 Redis 的容器网络地址；redis 容器需要加入共享网络并能用该名称解析。
REDIS_ADDR='redis:6379'

# Redis 实际认证密码；需与 Redis 服务端配置一致，填写当前有效或同步轮换后的密码。
REDIS_PASSWORD='replace-with-redis-password'

# Agent 使用的 Redis 逻辑数据库编号；保留 0。
REDIS_DB=0

# ==================== 4. 知识库对象存储 ====================
# 这些变量配置知识库原始文档的 MinIO 存储；向量模型、Milvus、文档处理器等继续使用挂载 YAML 的配置。

# Agent 访问 MinIO S3 API 的内网地址；使用 API 端口 9000，不是控制台端口 9001。
RAG_MINIO_ENDPOINT='myai-minio:9000'

# 已存在的 MinIO 应用 Access Key；该账户需有知识库桶的相应权限，单独填写此值不会创建账户。
RAG_MINIO_ACCESS_KEY='replace-with-minio-app-access-key'

# 上述 MinIO 应用 Access Key 对应的 Secret Key。
RAG_MINIO_SECRET_KEY='replace-with-minio-app-secret-key'

# 知识库原始文档存储桶名；保留原来的 myai-knowledge。
RAG_MINIO_BUCKET='myai-knowledge'

# MinIO 的 S3 签名区域；这里按默认区域 us-east-1 填写，需与实际服务配置一致。
RAG_MINIO_REGION='us-east-1'

# Agent 到 MinIO 内网连接是否启用 HTTPS；当前容器网络使用 HTTP，因此为 false。
RAG_MINIO_USE_SSL=false

# 桶不存在时是否尝试创建；true 要求应用账户有建桶权限，也可以提前建桶后改为 false。
RAG_MINIO_AUTO_CREATE_BUCKET=true

# ==================== 5. MCP-only 文件与短链接 ====================
# 必须另行部署支持文件生命周期的新版 short_links 后端；普通聊天可以不启用此能力。
# 当前未确认实际 URL 或机器 key，下面两项故意留空，状态为停用；不要根据旧域名或旧 key 推测。
# 后端应提供现有 10 个工具以及 get_asset_info、get_asset_download_url、create_asset_shortlink。

# Agent 可访问的 HTTP MCP 端点，包含 /api/mcp；为空且 YAML 的 short_links.mcp_url 为空时不注册。
SHORT_LINKS_MCP_URL=

# 在新版后端创建的机器调用 key；由 Agent 通过 X-API-Key 发送，不能写进手机应用或聊天消息。
SHORT_LINKS_API_KEY=

# 文件读取、上传、知识库导入和分享均经主机侧 files 服务调用该 MCP；缺少服务或工具时明确失败。
# 手机只使用配对后的 Relay 认证通道传输文件：256 KiB 原始数据块、512 KiB 上传 JSON 信封。
# 单文件大小范围为 1 字节至 50 MiB（1–52428800 字节，含边界），拒绝空文件（0 字节）。
# 主机按远端要求重组上传；后端非末片为 32 MiB，MCP 请求体上限为 48 MiB（包括 Base64/JSON 开销）。
# 普通上传仅产生 AssetID，不创建公开短链；分享须经过明确批准后单独创建短链。
# 解析仍在 MyAI 完成；structuredContent 传递资源元数据。没有旧附件 HTTP 回退。

# ==================== 6. OpenSandbox ====================
# deploy/opensandbox/docker-compose.yml 读取 OPENSANDBOX_API_KEY。
# 当前该独立 Compose 还需要配置加入 myai-shared 网络；仅设置 INFRA_NETWORK 不会自动接入网络。

# OpenSandbox 服务端 API 鉴权密钥；填写真实值，Agent 端通过下一组变量复用它。
OPENSANDBOX_API_KEY='replace-with-opensandbox-api-key'

# Agent 使用的沙箱提供方；保留 opensandbox，需要独立的 OpenSandbox 服务已启动且可访问。
SANDBOX_PROVIDER='opensandbox'

# Agent 到 OpenSandbox 控制服务的内网地址；myai-opensandbox-server 必须在共享网络中可解析。
SANDBOX_OPENSANDBOX_ENDPOINT='http://myai-opensandbox-server:8090'

# Agent 请求 OpenSandbox 时使用的 API 密钥；必须与服务端 OPENSANDBOX_API_KEY 一致。
SANDBOX_OPENSANDBOX_API_KEY="${OPENSANDBOX_API_KEY}"

# 通过 OpenSandbox 服务端代理访问沙箱，避免 Agent 容器直接使用服务端返回的宿主机回环地址。
SANDBOX_OPENSANDBOX_USE_SERVER_PROXY=true

# ==================== 7. 数据库写入持久化队列 ====================
# MongoDB 模式下，用私有 SQLite 日志保留已接受但尚未完成的数据库写入；需要包含该功能的新版本镜像。

# 本地日志路径；留空且 YAML 未指定时自动按工作目录分配到用户配置目录，根 Compose 已挂载对应持久卷。
PERSISTENCE_OUTBOX_PATH=

# 最多允许保留的待处理持久化批次数；达到上限会拒绝继续接收，不会静默丢弃已接受的数据。
PERSISTENCE_OUTBOX_MAX_PENDING=10000

# 日志允许的记录总数上限；包含待处理、完成回执及保留的屏障等记录，不得小于 MAX_PENDING。
PERSISTENCE_OUTBOX_MAX_ENTRIES=20000

# SQLite 主数据库页面的容量上限，单位字节；67108864 为 64 MiB，临时回滚日志另占磁盘空间。
PERSISTENCE_OUTBOX_MAX_BYTES=67108864

# 最多保留的已完成回执数；用于有限范围内的重复提交识别，不是永久的无限去重记录。
PERSISTENCE_OUTBOX_RETAIN_DONE=10000

# ==================== 8. 使用仓库 MinIO Compose 时的服务端参数 ====================
# 仅 deploy/minio/docker-compose.yml 使用这些变量；已经由其他方式部署 MinIO 时按其实际配置管理。
# 以下 root 凭据与应用 Access Key 是不同角色；本文件不会自动创建应用账户或授予桶权限。

# MinIO 服务端管理员用户名；填写实际部署使用的管理员账户，不要直接沿用示例默认账号。
MINIO_ROOT_USER='replace-with-minio-root-user'

# MinIO 服务端管理员密码；填写实际部署的管理员密码，与应用 Secret Key 分别管理。
MINIO_ROOT_PASSWORD='replace-with-minio-root-password'

# 仓库 minio-init 容器初始化的桶名；该初始化脚本只创建此桶，知识库桶由提前创建或 Agent 自动建桶负责。
MINIO_BUCKET='myai-assets'
