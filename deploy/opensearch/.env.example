# OpenSearch administrator password.
# OpenSearch requires upper/lower-case letters, a number, and a special character.
OPENSEARCH_INITIAL_ADMIN_PASSWORD=ChangeMe-OS@2026-Strong

# Keep the host port private. Containers on myai-shared use https://opensearch:9200.
OPENSEARCH_BIND=127.0.0.1
OPENSEARCH_PORT=9200

# 512 MB heap + native memory. Increase both this and the container limit together
# only when the server has enough free RAM.
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
OPENSEARCH_MEMORY_LIMIT=1g
OPENSEARCH_VOLUME_NAME=myai-opensearch-data
INFRA_NETWORK=myai-shared
