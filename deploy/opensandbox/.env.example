# Required. Use a long random value in the real .env file.
OPENSANDBOX_API_KEY=replace-with-a-long-random-key

# Keep the default when the Go agent runs on this same server.
OPENSANDBOX_API_BIND=127.0.0.1
OPENSANDBOX_API_PORT=8090
OPENSANDBOX_HOST_IP=127.0.0.1

# Pin images for repeatable deployment. Override only when upgrading deliberately.
OPENSANDBOX_SERVER_IMAGE=opensandbox/server:v0.2.2
OPENSANDBOX_EXECD_IMAGE=opensandbox/execd:v1.0.21
OPENSANDBOX_EGRESS_IMAGE=opensandbox/egress:v1.1.4
