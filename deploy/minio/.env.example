MINIO_ROOT_USER=replace-with-minio-admin-user
MINIO_ROOT_PASSWORD=replace-with-a-strong-password

# Match the root deployment; provision this external network before starting either stack.
INFRA_NETWORK=myai-shared

MINIO_API_BIND=127.0.0.1
MINIO_CONSOLE_BIND=127.0.0.1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

MINIO_BUCKET=myai-assets

# Use your public domain in production, for example:
# MINIO_SERVER_URL=https://minio-api.example.com
# MINIO_BROWSER_REDIRECT_URL=https://minio-console.example.com
MINIO_SERVER_URL=http://localhost:9000
MINIO_BROWSER_REDIRECT_URL=http://localhost:9001
