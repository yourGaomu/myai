{
  "expo": {
    "name": "MyAI Mobile",
    "slug": "myai-mobile",
    "version": "1.1.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3af2913f-516c-42c9-9f13-c1847c9a1a6d",
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-character.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F1114"
    },
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.myai.mobile",
      "versionCode": 9,
      "predictiveBackGestureEnabled": false,
      "navigationBar": {
        "backgroundColor": "#0F1114",
        "barStyle": "light-content"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F1114",
          "image": "./assets/splash-character.png",
          "imageWidth": 260,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-navigation-bar",
        {
          "hidden": false,
          "style": "light",
          "enforceContrast": false
        }
      ],
      "expo-updates",
      "expo-sqlite",
      "./plugins/withRelayForegroundService",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "3af2913f-516c-42c9-9f13-c1847c9a1a6d"
      }
    }
  }
}
