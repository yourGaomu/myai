MYAI_RELAY_AGENT_TOKEN=replace-with-a-long-random-token
MYAI_AGENT_USER=local
MYAI_AGENT_DEVICE=server-agent
MYAI_WORKSPACE_PATH=/srv/myai/workspace
INFRA_NETWORK=myai-shared

# Published image references. compose.prod.yaml pulls these images; it does not build source code.
MYAI_RELAY_IMAGE=ghcr.io/yourgaomu/myai-relay:latest
MYAI_AGENT_IMAGE=ghcr.io/yourgaomu/myai-agent:latest
MYAI_URL_SHORTENER_IMAGE=ghcr.io/yourgaomu/myai-url-shortener:latest

MYAI_BASE_URL=https://api.example.com/v1
MYAI_API_KEY=replace-with-model-api-key
MYAI_MODEL=gpt-5.5

MONGO_URI=mongodb://username:password@mongodb:27017/?authSource=admin&replicaSet=rs0&directConnection=true
MONGO_DATABASE=myai
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

RAG_MINIO_ENDPOINT=myai-minio:9000
RAG_MINIO_ACCESS_KEY=replace-with-minio-access-key
RAG_MINIO_SECRET_KEY=replace-with-minio-secret-key
RAG_MINIO_BUCKET=myai-knowledge
RAG_MINIO_USE_SSL=false

SANDBOX_PROVIDER=opensandbox
SANDBOX_OPENSANDBOX_ENDPOINT=http://myai-opensandbox-server:8090
SANDBOX_OPENSANDBOX_API_KEY=replace-with-opensandbox-api-key

# Set this only when the shortener profile is enabled.
ASSET_SHORTENER_BASE_URL=http://url-shortener:18081

URL_SHORTENER_ADDR=:18081
URL_SHORTENER_BASE_URL=https://assets.example.com
URL_SHORTENER_STORE=mongo
URL_SHORTENER_MONGO_URI=mongodb://username:password@mongodb:27017/?authSource=admin&replicaSet=rs0&directConnection=true
URL_SHORTENER_MONGO_DATABASE=myai
URL_SHORTENER_REDIS_ENABLED=false
URL_SHORTENER_REDIS_ADDR=redis:6379
URL_SHORTENER_REDIS_PASSWORD=
URL_SHORTENER_REDIS_DB=0
URL_SHORTENER_MINIO_ENDPOINT=myai-minio:9000
URL_SHORTENER_MINIO_PUBLIC_ENDPOINT=https://assets.example.com
URL_SHORTENER_MINIO_REGION=us-east-1
URL_SHORTENER_MINIO_ACCESS_KEY=
URL_SHORTENER_MINIO_SECRET_KEY=
URL_SHORTENER_MINIO_BUCKET=myai-assets
URL_SHORTENER_MINIO_USE_SSL=false
URL_SHORTENER_MINIO_ENSURE_BUCKET=true
