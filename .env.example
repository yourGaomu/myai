# Compose uses this file for interpolation; each service receives only its explicit environment list.
# Add custom MCP credential variables through an Agent-only Compose overlay.
MYAI_RELAY_AGENT_TOKEN=replace-with-a-long-random-token
MYAI_AGENT_USER=local
MYAI_AGENT_DEVICE=server-agent
# Optional additional user/device=token entries, separated by commas.
MYAI_RELAY_AGENT_CREDENTIALS=
# Optional browser origins for local Expo Web development. Same-origin relay
# pages and native Android clients do not need this setting.
MYAI_RELAY_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
MYAI_WORKSPACE_PATH=/srv/myai/workspace
INFRA_NETWORK=myai-shared

# Published image references. compose.prod.yaml pulls these images; it does not build source code.
MYAI_RELAY_IMAGE=ghcr.io/yourgaomu/myai-relay:latest
MYAI_AGENT_IMAGE=ghcr.io/yourgaomu/myai-agent:latest

# Optional overrides left empty use the mounted application YAML values.
MYAI_PROVIDER=
MYAI_PROTOCOL=
MYAI_AUTH_TYPE=
MYAI_BASE_URL=https://api.example.com/v1
MYAI_API_KEY=replace-with-model-api-key
MYAI_MODEL=gpt-5.5
MYAI_TEMPERATURE=
MYAI_TOP_P=
MYAI_MAX_OUTPUT_TOKENS=
# Provider-declared capacity; 0 leaves it unknown (conservative fallback).
MYAI_CONTEXT_WINDOW_TOKENS=0
MYAI_MAX_OUTPUT_LIMIT=0

MONGO_URI=mongodb://username:password@mongodb:27017/?authSource=admin&replicaSet=rs0&directConnection=true
MONGO_DATABASE=myai
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# RAG switches are independent; leave empty to preserve application YAML settings.
# Embedding model lists remain in application.yaml (rag.embedding.models).
RAG_ID_NODE=
RAG_MILVUS_ENABLED=
RAG_MILVUS_ADDRESS=
RAG_MILVUS_USERNAME=
RAG_MILVUS_PASSWORD=
RAG_MILVUS_DATABASE=
RAG_MILVUS_API_KEY=
RAG_MILVUS_ENABLE_TLS=
RAG_MILVUS_COLLECTION_PREFIX=
RAG_MILVUS_SHARDS=
RAG_LOCAL_ENABLED=
RAG_LOCAL_PATH=
RAG_LOCAL_VECTOR_PATH=
RAG_LOCAL_MAX_OPEN_CONNECTIONS=
RAG_RETRIEVAL_CANDIDATE_MULTIPLIER=
RAG_RETRIEVAL_MAX_CANDIDATES=
RAG_RETRIEVAL_MIN_LOCAL_RESULTS=
RAG_RETRIEVAL_MIN_LOCAL_SCORE=
RAG_RETRIEVAL_RRF_K=
RAG_RETRIEVAL_CACHE_REMOTE_RESULTS=
RAG_DOCUMENT_PROCESSOR_ENABLED=
RAG_DOCUMENT_PROCESSOR_PYTHON_EXECUTABLE=
RAG_DOCUMENT_PROCESSOR_SCRIPT=
RAG_DOCUMENT_PROCESSOR_WORKING_DIRECTORY=
RAG_DOCUMENT_PROCESSOR_TRANSPORT=
RAG_DOCUMENT_PROCESSOR_WORKER_COUNT=
RAG_DOCUMENT_PROCESSOR_MAX_PENDING_JOBS=
RAG_DOCUMENT_PROCESSOR_STARTUP_TIMEOUT_SECONDS=
RAG_DOCUMENT_PROCESSOR_TIMEOUT_SECONDS=
RAG_DOCUMENT_PROCESSOR_SHUTDOWN_GRACE_SECONDS=
RAG_DOCUMENT_PROCESSOR_MAX_DOCUMENT_SIZE_MB=
RAG_DOCUMENT_PROCESSOR_CONTENT_CHUNK_KB=
RAG_DOCUMENT_PROCESSOR_CHUNK_BATCH_SIZE=
RAG_DOCUMENT_PROCESSOR_GRPC_MAX_MESSAGE_MB=
RAG_DOCUMENT_PROCESSOR_TEMP_DIRECTORY=
# deploy/minio uses the same external INFRA_NETWORK for this container address.
RAG_MINIO_ENDPOINT=myai-minio:9000
RAG_MINIO_ACCESS_KEY=replace-with-minio-access-key
RAG_MINIO_SECRET_KEY=replace-with-minio-secret-key
RAG_MINIO_SESSION_TOKEN=
RAG_MINIO_BUCKET=myai-knowledge
RAG_MINIO_REGION=
RAG_MINIO_USE_SSL=false
RAG_MINIO_AUTO_CREATE_BUCKET=

SANDBOX_PROVIDER=opensandbox
SANDBOX_OPENSANDBOX_ENDPOINT=http://myai-opensandbox-server:8090
SANDBOX_OPENSANDBOX_API_KEY=replace-with-opensandbox-api-key
SANDBOX_OPENSANDBOX_USE_SERVER_PROXY=
SANDBOX_OPENSANDBOX_IMAGE=
SANDBOX_OPENSANDBOX_CPU=
SANDBOX_OPENSANDBOX_MEMORY=
SANDBOX_OPENSANDBOX_SANDBOX_TIMEOUT_SECONDS=
SANDBOX_OPENSANDBOX_COMMAND_TIMEOUT_SECONDS=
SANDBOX_OPENSANDBOX_REQUEST_TIMEOUT_SECONDS=
SANDBOX_OPENSANDBOX_MAX_DOWNLOAD_MB=

MEMORY_EXTRACTION_MODEL_ID=
MEMORY_DREAM_MODEL_ID=
SKILL_ROOT=
SKILL_REGISTRY=
MYAI_PYTHON_BIN=
SKILLHUB_BASH=
SUBAGENT_WORKER_COUNT=
SUBAGENT_QUEUE_SIZE=
SUBAGENT_SNAPSHOT_ROOT=
PLUGIN_ENABLED=
PLUGIN_ROOT=
THREAD_CORE=
THREAD_QUEUESIZE=

# 1. External short-links backend. Leave URL empty to disable this integration.
# The URL must include /api/mcp. Keep the real key only in deployment secrets.
SHORT_LINKS_MCP_URL=
SHORT_LINKS_API_KEY=

# Legacy attachment service for share_file/read_asset and existing mobile uploads.
# Leave both this URL and asset.shortener_base_url in YAML empty to disable it.
# When enabled, ASSET_API_KEY must match the legacy server's URL_SHORTENER_API_KEY.
ASSET_SHORTENER_BASE_URL=
ASSET_API_KEY=
ASSET_UPLOAD_TIMEOUT_SECONDS=
ASSET_TTL_SECONDS=
ASSET_MAX_VISITS=
